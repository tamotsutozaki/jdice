server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Upstream da API vem de uma variável de ambiente (envsubst na subida do
    # nginx), então o mesmo build serve o compose (api:8080) e a Azure (o FQDN
    # interno do Container App). O bundle continua usando caminho relativo.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        # Não sobrescrever o Host: o nginx usa o host do proxy_pass (o FQDN
        # interno do app na Azure), que o Envoy do Container Apps exige para
        # rotear. Passar o Host original (o do web) faz o Envoy responder
        # "Unavailable". Localmente o Kestrel aceita qualquer Host (AllowedHosts=*).
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
    }

    # SPA: qualquer rota desconhecida devolve o index e o router do Angular resolve.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
