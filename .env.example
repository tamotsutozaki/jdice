# Copie para .env e ajuste. O .env não vai para o repositório.
#
# JWT_SIGNING_KEY é obrigatória: o compose recusa subir sem ela, de propósito.
# Um segredo com valor padrão acaba virando o segredo de produção de alguém.
# Gere uma chave forte com:
#   openssl rand -base64 48
JWT_SIGNING_KEY=

POSTGRES_DB=jdice
POSTGRES_USER=jdice
POSTGRES_PASSWORD=jdice
# 5433 evita conflito com instalação nativa do Postgres, que usa 5432.
POSTGRES_PORT=5433

API_PORT=5080
WEB_PORT=8080

ASPNETCORE_ENVIRONMENT=Production
CORS_ORIGIN=http://localhost:4200

# Administrador inicial. Só é criado se o banco ainda não tiver nenhuma conta.
# Deixe em branco para não criar ninguém — nesse caso não há como entrar.
# A senha precisa de no mínimo 12 caracteres.
SEED_ADMIN_EMAIL=admin@jdice.local
SEED_ADMIN_PASSWORD=

# Por onde os e-mails saem: "Mailpit" (captura, padrão) ou "Azure".
# Deixe Mailpit para desenvolver sem mandar e-mail de verdade a ninguém.
EMAIL_PROVIDER=Mailpit

# Servidor SMTP do Mailpit (usado quando EMAIL_PROVIDER=Mailpit). Captura as
# mensagens sem entregar a ninguém (interface em :8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=nao-responda@jdice.local
SMTP_FROM_NAME=JDice
MAILPIT_UI_PORT=8025

# Azure Communication Services — Email (usado quando EMAIL_PROVIDER=Azure).
# ACS_CONNECTION_STRING vem do portal (recurso ACS > Keys). É segredo.
# ACS_SENDER_ADDRESS precisa ser de um domínio verificado no recurso.
#   EMAIL_PROVIDER=Azure
#   ACS_CONNECTION_STRING=endpoint=https://SEU-RECURSO.communication.azure.com/;accesskey=...
#   ACS_SENDER_ADDRESS=nao-responda@tomore.co
ACS_CONNECTION_STRING=
ACS_SENDER_ADDRESS=

# Disparos processados ao mesmo tempo por worker.
WORKER_COUNT=4

# Fila que reparte as entregas entre os workers. Desligada, o disparo roda em
# série dentro do próprio job — suficiente para volumes pequenos.
RABBITMQ_ENABLED=true
RABBITMQ_USER=jdice
RABBITMQ_PASSWORD=jdice
RABBITMQ_UI_PORT=15672
RABBITMQ_PREFETCH=10
